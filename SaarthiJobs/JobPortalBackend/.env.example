# Example .env - copy to backend/.env and fill with real values (DO NOT COMMIT the real .env)

# Security
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_VALUE

# Database
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306

# Server
PORT=8080
NODE_ENV=production

# Frontend URLs (for CORS configuration)
FRONTEND_URL=https://saarthijobs.com
ADMIN_FRONTEND_URL=https://admin.saarthijobs.com

# Email (for OTP sending)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password

# Email / OAuth (for bulk email sending via AdminSendEmail)
EMAIL_HOST=your.email@example.com
CLIENT_ID=your_google_oauth_client_id
CLIENT_SECRET=your_google_oauth_client_secret
REDIRECT_URI=https://yourapp.example.com/oauth/callback
OAUTH_REFRESH_TOKEN=replace_with_refresh_token

# GCS
GCS_BUCKET=your_gcs_bucket_name
GCS_KEY_PATH=backend/gcs-key.json # keep local and do not commit

# reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ─── SaarthiIQ Integration ────────────────────────────────────────────────────
# Syncs candidate profiles to SaarthiIQ after a successful resume upload.
# See: utils/saarthiIQService.js
#
# SAARTHIQ_API_URL      - Base URL of the SaarthiIQ REST API
# SAARTHIQ_API_KEY      - Bearer token for authenticating with SaarthiIQ
# SAARTHIQ_IMPORT_PATH  - ⚠️  PLACEHOLDER: endpoint that receives candidate data.
#                         Update this once SaarthiIQ implements the import route.
#                         Defaults to /api/candidates/import if not set.
SAARTHIQ_API_URL=https://api.saarthiq.in
SAARTHIQ_API_KEY=your_saarthiq_api_key
SAARTHIQ_IMPORT_PATH=/api/candidates/import
